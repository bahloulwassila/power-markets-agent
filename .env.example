# -------- Copy this file to .env and fill in your keys --------
# Never commit your real .env — it's in .gitignore.

# AESO Pool Price API (free)
# Register: https://apim-aeso-connect.developer.azure-api.net/
AESO_API_KEY=your_aeso_key_here

# Anthropic API (for brief generation, Phase 3)
# Register: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: NewsAPI (Phase 1 fallback if RSS coverage is thin)
NEWSAPI_KEY=

# Optional: Slack webhook for daily delivery (Phase 4)
SLACK_WEBHOOK_URL=
